<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/relativeLayout2"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/plusRepBackground"
    tools:context=".Forum">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/friendReqRecView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="5dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomNavbar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/forumChipsScrollView" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:itemBackground="@color/plusRepBackground"
        app:itemIconTint="@drawable/selector"
        app:itemTextColor="@drawable/selector"
        app:labelVisibilityMode="selected"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/menu">

    </com.google.android.material.bottomnavigation.BottomNavigationView>

    <HorizontalScrollView
        android:id="@+id/forumChipsScrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@+id/friendReqRecView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/forumChipsLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/forumChipsChipGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="5dp"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/csChip"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="0dp"
                    android:text="@string/CSGO"
                    android:textColor="@drawable/chip_text_forum"
                    android:textSize="16sp"
                    app:checkedIconTint="@drawable/chip_text_forum"
                    app:chipBackgroundColor="@drawable/chip_color_forum"
                    app:chipMinTouchTargetSize="48dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/codChip"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/COD"
                    android:textColor="@drawable/chip_text_forum"
                    android:textSize="16sp"
                    app:checkedIconTint="@drawable/chip_text_forum"
                    app:chipBackgroundColor="@drawable/chip_color_forum"
                    app:chipMinTouchTargetSize="48dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/gtaChip"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/GTAV"
                    android:textColor="@drawable/chip_text_forum"
                    android:textSize="16sp"
                    app:checkedIconTint="@drawable/chip_text_forum"
                    app:chipBackgroundColor="@drawable/chip_color_forum"
                    app:chipMinTouchTargetSize="48dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/kind2Chip"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Kindergarten2"
                    android:textColor="@drawable/chip_text_forum"
                    android:textSize="16sp"
                    app:checkedIconTint="@drawable/chip_text_forum"
                    app:chipBackgroundColor="@drawable/chip_color_forum"
                    app:chipMinTouchTargetSize="48dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/destinyChip"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Destiny2"
                    android:textColor="@drawable/chip_text_forum"
                    android:textSize="16sp"
                    app:checkedIconTint="@drawable/chip_text_forum"
                    app:chipBackgroundColor="@drawable/chip_color_forum"
                    app:chipMinTouchTargetSize="48dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/bigThinkerChip"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/BigThinkersKindergarten"
                    android:textColor="@drawable/chip_text_forum"
                    android:textSize="16sp"
                    app:checkedIconTint="@drawable/chip_text_forum"
                    app:chipBackgroundColor="@drawable/chip_color_forum"
                    app:chipMinTouchTargetSize="48dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/childofMortaChip"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ChildrenOfMorta"
                    android:textColor="@drawable/chip_text_forum"
                    android:textSize="16sp"
                    app:checkedIconTint="@drawable/chip_text_forum"
                    app:chipBackgroundColor="@drawable/chip_color_forum"
                    app:chipMinTouchTargetSize="48dp" />
            </com.google.android.material.chip.ChipGroup>

        </LinearLayout>
    </HorizontalScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/newPostButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:src="@drawable/ic_edit"
        android:backgroundTint="@color/plusRepPurple"
        app:layout_constraintBottom_toTopOf="@+id/bottomNavbar"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/nothingForum"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="nothing to see here\n         (ಥ﹏ಥ)"
        android:textColor="@color/plusRepBackgroundbrigther"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="@+id/friendReqRecView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/friendReqRecView"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>